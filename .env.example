# =============================================================================
# RedStore – environment variables (example)
# Copy to `.env` for local development. Never commit the real `.env` file.
# On Render, add these values in the service's Environment tab.
# =============================================================================

APP_ENV=production

# --- Supabase PostgreSQL -----------------------------------------------------
# Option A (recommended): a single connection URL.
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Prefer the Session pooler (port 5432) or the direct connection if your host
# supports IPv6. Transaction pooler (port 6543) can be used but may restrict
# server-side prepared statements.
DATABASE_URL=

# Option B: individual values (used when DATABASE_URL is empty).
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require

# --- Supabase Storage --------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=product-images

# Optional: full public base URL for the bucket, including the bucket name.
# Only set this if you use a custom domain or a non-standard public URL.
# Example: https://abcdefghijklmnop.supabase.co/storage/v1/object/public/product-images
SUPABASE_STORAGE_PUBLIC_URL=

# Used by the admin dashboard to upload product images. NEVER expose this in
# browser JavaScript or commit it to source control.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin sessions ----------------------------------------------------------
# Leave blank to auto-detect: secure cookies are forced in production and when
# the request arrives over HTTPS. Set to 0 only for plain-HTTP local testing.
SESSION_COOKIE_SECURE=

# --- Optional CORS -----------------------------------------------------------
# Leave blank for the normal same-origin deployment (frontend + API on one
# domain). For local development with a separate static server, set this to the
# static server origin, e.g. http://localhost:8000
CORS_ALLOWED_ORIGIN=
